{
    "download-dir": "${DIR_TORRENTS}",
    "incomplete-dir": "${DIR_INCOMPLETE}",
    "incomplete-dir-enabled": true,
    "rpc-enabled": true,
    "rpc-bind-address": "0.0.0.0",
    "rpc-port": ${TRANSMISSION_WEB_PORT},
    "rpc-username": "${TRANSMISSION_USER}",
    "rpc-password": "${TRANSMISSION_PASS}",
    "rpc-authentication-required": true,
    "rpc-whitelist-enabled": true,
    "rpc-whitelist": "127.0.0.1,192.168.*.*,10.*.*.*,172.16.*.*,172.17.*.*,172.18.*.*,172.19.*.*,172.20.*.*,172.21.*.*,172.22.*.*,172.23.*.*,172.24.*.*,172.25.*.*,172.26.*.*,172.27.*.*,172.28.*.*,172.29.*.*,172.30.*.*,172.31.*.*,100.*.*.*",
    "rpc-host-whitelist-enabled": false,
    "dht-enabled": true,
    "lpd-enabled": false,
    "pex-enabled": true,
    "peer-port": ${TRANSMISSION_PEER_PORT},
    "peer-port-random-on-start": false,
    "port-forwarding-enabled": false,
    "speed-limit-down-enabled": false,
    "speed-limit-up-enabled": false,
    "encryption": 1,
    "cache-size-mb": 16,
    "message-level": 2,
    "umask": 2,
    "script-torrent-done-enabled": false
}
